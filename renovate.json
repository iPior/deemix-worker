{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:recommended",
		":semanticCommits",
		"security:only-security-updates",
		"security:openssf-scorecard"
	],
	"packageRules": [
		{
			"matchFileNames": [".github/workflows/pull-request.yml"],
			"matchPackageNames": ["*"],
			"semanticCommitScope": "ci",
			"enabled": true
		}
	],
	"osvVulnerabilityAlerts": true,
	"vulnerabilityAlerts": {
		"enabled": true,
		"labels": ["security"]
	}
}
